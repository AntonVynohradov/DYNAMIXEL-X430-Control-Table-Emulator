    given-names: Anton
    orcid: "https://orcid.org/0009-0005-6965-0911"
    affiliation: SystemFromScratch
    website: "https://systemfromscratch.com"
repository-code: "https://github.com/AntonVynohradov/DYNAMIXEL-X430-Control-Table-Emulator"
url: "https://antonvynohradov.github.io/DYNAMIXEL-X430-Control-Table-Emulator/"
license: Apache-2.0
keywords:
  - embedded systems
  - C11
  - MISRA C
  - DYNAMIXEL
  - Protocol 2.0
  - robotics
  - servo emulation
