# The build directory is ignored to prevent committing build artifacts
build/
out/

# Cppcheck dump files (left behind if misra-analyze is interrupted)
*.dump
*.ctu-info

# The PyTest cache, Python bytecode cache and virtual environments
__pycache__/
*.pyc
.pytest_cache/
.venv/

# MkDocs output and the PDF manual copied into the site by CI
site/
docs/downloads/

# Kconfig outputs written outside the build tree by hand-run tools
.config
.config.old
