# Build trees (CMake presets build into build/<preset>)
build/
out/

# Cppcheck dump files (left behind if misra-analyze is interrupted)
*.dump
*.ctu-info

# Python caches and virtual environments
__pycache__/
*.pyc
.venv/

# Kconfig outputs written outside the build tree by hand-run tools
.config
.config.old

# MkDocs output
site/
